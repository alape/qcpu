`ifndef REGISTERS_VH_
`define REGISTERS_VH_

// special registers
`define REG_ZEROES_ADDR 4'h0
`define REG_ONES_ADDR   4'h1
`define REG_PC_ADDR     4'h2
`define REG_SC_ADDR     4'h3

// general-purpose registers
`define REG_R0_ADDR 4'h8
`define REG_R1_ADDR 4'h9
`define REG_R2_ADDR 4'hA
`define REG_R3_ADDR 4'hB
`define REG_R4_ADDR 4'hC
`define REG_R5_ADDR 4'hD
`define REG_R6_ADDR 4'hE
`define REG_R7_ADDR 4'hF

`endif